{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi"
    },
    "collector": {
      "root": "apps/collector",
      "runtime": "python",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "APIX_API_URL"
        }
      ]
    },
    "scheduler": {
      "root": "apps/scheduler",
      "runtime": "python",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "APIX_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(healthz|readyz|metrics|docs|redoc|openapi.json)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
